DATABASE_URL=
JWT_SECRET=
# 로컬 개발에서만 1. JWT_SECRET 이 없을 때 저장소에 공개된 개발용 키를 쓴다 (운영에 넣지 말 것)
JWT_DEV_SECRET=
DEPLOYMENTS_FILE=
CHAIN_RPC_URL=
# 노드 없이 개발할 때만 1 (가짜 체인). CHAIN_RPC_URL 과 둘 중 하나만 둔다
CHAIN_FAKE=
# 쓰기 서버만 둔다. 비워 두면 체인을 조회만 한다
RELAYER_PRIVATE_KEY=
# 학생 지갑 HD 니모닉 (BIP-39). 학생 주소를 m/44'/60'/0'/0/{wallet_index} 로 파생한다. 바꾸면 모든 학생 주소가 바뀐다
STUDENT_WALLET_MNEMONIC=
# 알림 (docs/NOTIFICATION_API.md 「서버 설정」). 학생 서버는 NOTIFICATION_WORKER=0
NOTIFICATION_WORKER=
NOTIFICATION_REMIND_SECONDS=
NOTIFICATION_TICK_SECONDS=
NOTIFICATION_DEADLINE_NEAR_SECONDS=
OCR_API_KEY=
OPENBANKING_CLIENT_ID=
OPENBANKING_CLIENT_SECRET=
